<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Codebelt.Coverlet.MTP" Version="11.0.0" />
    <PackageVersion Include="Codebelt.Extensions.Xunit" Version="13.0.0" />
    <PackageVersion Include="Codebelt.Extensions.Xunit.App" Version="13.0.0" />
    <PackageVersion Include="Cuemon.AspNetCore.Mvc" Version="11.0.0" />
    <PackageVersion Include="Cuemon.Core" Version="11.0.0" />
    <PackageVersion Include="Cuemon.Extensions.AspNetCore" Version="11.0.0" />
    <PackageVersion Include="Cuemon.Extensions.AspNetCore.Authentication" Version="11.0.0" />
    <PackageVersion Include="Cuemon.Extensions.AspNetCore.Mvc" Version="11.0.0" />
    <PackageVersion Include="Cuemon.Extensions.Core" Version="11.0.0" />
    <PackageVersion Include="Cuemon.Extensions.IO" Version="11.0.0" />
    <PackageVersion Include="Cuemon.IO" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.runner.console" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10'))">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net11'))">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="11.0.0" />
  </ItemGroup>
</Project>
